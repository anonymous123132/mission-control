#!/bin/sh
set -eu

APP_DIR="/usr/lib/mission-control"
SYSTEM_CONFIG_DIR="/etc/mission-control"
SYSTEM_CONFIG_FILE="$SYSTEM_CONFIG_DIR/config.env"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/mission-control"
USER_CONFIG_FILE="$USER_CONFIG_DIR/config.env"

DEFAULT_HOSTNAME="127.0.0.1"
DEFAULT_PORT="3000"
DEFAULT_DATA_DIR_SYSTEM="/var/lib/mission-control"
DEFAULT_DATA_DIR_USER="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/share}/mission-control"

print_usage() {
  cat <<'USAGE'
Usage:
  mission-control [start] [--port <port>] [--hostname <host>] [--data-dir <dir>] [--no-prompt]
  mission-control configure
  mission-control help

Notes:
  - First run will prompt for a port (default: 3000) when running in a TTY.
  - System config: /etc/mission-control/config.env (for systemd service)
  - User config:   ~/.config/mission-control/config.env (for non-root runs)
USAGE
}

load_config() {
  if [ -f "$SYSTEM_CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$SYSTEM_CONFIG_FILE"
  fi
  if [ -f "$USER_CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$USER_CONFIG_FILE"
  fi
}

pick_config_target() {
  if [ "${USE_SYSTEM_CONFIG:-0}" = "1" ]; then
    CONFIG_DIR="$SYSTEM_CONFIG_DIR"
    CONFIG_FILE="$SYSTEM_CONFIG_FILE"
    return 0
  fi

  if [ "${USE_USER_CONFIG:-0}" = "1" ]; then
    CONFIG_DIR="$USER_CONFIG_DIR"
    CONFIG_FILE="$USER_CONFIG_FILE"
    return 0
  fi

  if [ "$(id -u)" = "0" ]; then
    CONFIG_DIR="$SYSTEM_CONFIG_DIR"
    CONFIG_FILE="$SYSTEM_CONFIG_FILE"
    return 0
  fi

  CONFIG_DIR="$USER_CONFIG_DIR"
  CONFIG_FILE="$USER_CONFIG_FILE"
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
  chmod 0755 "$CONFIG_DIR" || true
}

ensure_data_dir() {
  local data_dir="${MISSION_CONTROL_DATA_DIR}"
  if [ -z "$data_dir" ]; then
    if [ "$(id -u)" = "0" ] || [ "${USE_SYSTEM_CONFIG:-0}" = "1" ]; then
      data_dir="$DEFAULT_DATA_DIR_SYSTEM"
    else
      data_dir="$DEFAULT_DATA_DIR_USER"
    fi
    MISSION_CONTROL_DATA_DIR="$data_dir"
  fi
  mkdir -p "$data_dir"
  chmod 0750 "$data_dir" || true
}

write_config() {
  ensure_config_dir
  umask 0022
  {
    printf '%s\n' "# Managed by mission-control. Edit to customize."
    printf 'HOSTNAME=%s\n' "${HOSTNAME:-$DEFAULT_HOSTNAME}"
    printf 'PORT=%s\n' "${PORT:-$DEFAULT_PORT}"
    printf 'MISSION_CONTROL_DATA_DIR=%s\n' "${MISSION_CONTROL_DATA_DIR:-}"
  } >"$CONFIG_FILE"
}

prompt_port_if_needed() {
  if [ "${NO_PROMPT:-0}" = "1" ]; then
    return 0
  fi

  if [ -n "${PORT:-}" ]; then
    return 0
  fi

  if [ ! -t 0 ]; then
    return 0
  fi

  printf 'Mission Control port [%s]: ' "$DEFAULT_PORT" >&2
  read -r input_port || input_port=""
  input_port="$(printf '%s' "$input_port" | tr -d '[:space:]')"
  if [ -z "$input_port" ]; then
    PORT="$DEFAULT_PORT"
  else
    PORT="$input_port"
  fi
}

PORT="${PORT:-}"
HOSTNAME="${HOSTNAME:-}"
MISSION_CONTROL_DATA_DIR="${MISSION_CONTROL_DATA_DIR:-}"
NO_PROMPT="0"
USE_SYSTEM_CONFIG="0"
USE_USER_CONFIG="0"

COMMAND="start"
while [ "$#" -gt 0 ]; do
  case "$1" in
    start|configure)
      COMMAND="$1"
      shift 1
      ;;
    --port)
      PORT="${2:-}"
      shift 2
      ;;
    --hostname)
      HOSTNAME="${2:-}"
      shift 2
      ;;
    --data-dir)
      MISSION_CONTROL_DATA_DIR="${2:-}"
      shift 2
      ;;
    --no-prompt)
      NO_PROMPT="1"
      shift 1
      ;;
    --system-config)
      USE_SYSTEM_CONFIG="1"
      USE_USER_CONFIG="0"
      shift 1
      ;;
    --user-config)
      USE_USER_CONFIG="1"
      USE_SYSTEM_CONFIG="0"
      shift 1
      ;;
    -h|--help|help)
      print_usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      print_usage >&2
      exit 2
      ;;
  esac
done

case "$COMMAND" in
  configure)
    load_config
    pick_config_target
    HOSTNAME="${HOSTNAME:-$DEFAULT_HOSTNAME}"
    prompt_port_if_needed
    PORT="${PORT:-$DEFAULT_PORT}"
    ensure_data_dir
    write_config
    echo "Wrote $CONFIG_FILE" >&2
    exit 0
    ;;
  start|"")
    load_config
    pick_config_target
    HOSTNAME="${HOSTNAME:-$DEFAULT_HOSTNAME}"
    prompt_port_if_needed
    PORT="${PORT:-$DEFAULT_PORT}"
    ensure_data_dir

    if [ ! -f "$CONFIG_FILE" ]; then
      write_config || true
    fi
    # If config exists but PORT is unset, try to persist the prompted/default port.
    if [ -f "$CONFIG_FILE" ] && ! grep -q '^PORT=' "$CONFIG_FILE" 2>/dev/null; then
      write_config || true
    fi

    export HOSTNAME PORT MISSION_CONTROL_DATA_DIR
    exec "$APP_DIR/node/bin/node" "$APP_DIR/server.js"
    ;;
  *)
    print_usage >&2
    exit 2
    ;;
esac
