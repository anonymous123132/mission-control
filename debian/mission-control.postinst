#!/bin/sh
set -e

case "$1" in
  configure|abort-upgrade|abort-remove|abort-deconfigure)
    exit 0
    ;;
esac

if ! getent group mission-control >/dev/null; then
  addgroup --system mission-control >/dev/null
fi

if ! getent passwd mission-control >/dev/null; then
  adduser --system --ingroup mission-control --home /var/lib/mission-control --no-create-home --shell /usr/sbin/nologin mission-control >/dev/null
fi

install -d -m 0750 -o mission-control -g mission-control /var/lib/mission-control

install -d -m 0755 /etc/mission-control
if [ ! -f /etc/mission-control/config.env ]; then
  umask 0022
  {
    printf '%s\n' "# Managed by mission-control. Edit to customize."
    printf 'HOSTNAME=%s\n' "127.0.0.1"
    printf 'MISSION_CONTROL_DATA_DIR=%s\n' "/var/lib/mission-control"
  } >/etc/mission-control/config.env
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
